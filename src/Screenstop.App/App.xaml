<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Screenstop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== Palette (slate dark + blue accent) ===== -->
            <SolidColorBrush x:Key="Sd.Bg" Color="#FF0B1220"/>
            <SolidColorBrush x:Key="Sd.BgRaised" Color="#FF111827"/>
            <SolidColorBrush x:Key="Sd.Panel" Color="#FF1F2937"/>
            <SolidColorBrush x:Key="Sd.PanelHover" Color="#FF2B3648"/>
            <SolidColorBrush x:Key="Sd.PanelPressed" Color="#FF374151"/>
            <SolidColorBrush x:Key="Sd.Border" Color="#FF374151"/>
            <SolidColorBrush x:Key="Sd.BorderSoft" Color="#FF2A3441"/>
            <SolidColorBrush x:Key="Sd.Text" Color="#FFF3F4F6"/>
            <SolidColorBrush x:Key="Sd.TextMuted" Color="#FF9CA3AF"/>
            <SolidColorBrush x:Key="Sd.Accent" Color="#FF3B82F6"/>
            <SolidColorBrush x:Key="Sd.AccentHover" Color="#FF2563EB"/>
            <SolidColorBrush x:Key="Sd.AccentPressed" Color="#FF1D4ED8"/>
            <SolidColorBrush x:Key="Sd.AccentSoft" Color="#FF1E3A5F"/>

            <CornerRadius x:Key="Sd.Radius">6</CornerRadius>
            <Thickness x:Key="Sd.ButtonPadding">10,5,10,5</Thickness>

            <!-- Base chrome shared by every button/toggle template -->
            <ControlTemplate x:Key="Sd.ChromeButton" TargetType="ButtonBase">
                <Border x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Sd.Radius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Default button: quiet panel chrome -->
            <Style x:Key="Sd.Button" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Sd.Panel}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="{StaticResource Sd.ButtonPadding}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template" Value="{StaticResource Sd.ChromeButton}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.PanelHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.PanelPressed}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Accent (primary action, e.g. Save) -->
            <Style x:Key="Sd.AccentButton" TargetType="Button" BasedOn="{StaticResource Sd.Button}">
                <Setter Property="Background" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.AccentHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.AccentPressed}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Ghost: low-emphasis actions (close/dismiss) -->
            <Style x:Key="Sd.GhostButton" TargetType="Button" BasedOn="{StaticResource Sd.Button}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.TextMuted}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.Panel}"/>
                        <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Tool toggle: segmented control look; checked = accent tint -->
            <Style x:Key="Sd.ToolToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.TextMuted}"/>
                <Setter Property="Padding" Value="8,6,8,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.Panel}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.AccentSoft}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark tooltip so popups match the chrome -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource Sd.Panel}"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,5,8,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Group separator used between toolbar clusters -->
            <Style x:Key="Sd.VSeparator" TargetType="Border">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Margin" Value="8,4,8,4"/>
                <Setter Property="Background" Value="{StaticResource Sd.BorderSoft}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

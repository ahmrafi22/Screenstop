<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Screenstop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Screenstop.App.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== Palette (mac Screenstop parity) =====
                 Workspace ground: AnnoTheme.neutralSolid dark (#292929 = white*0.16).
                 Accent/selection: tl color selection stroke, #3182ED.
                 Text: Apple label/secondaryLabel equivalents. -->
            <SolidColorBrush x:Key="Sd.Bg" Color="#FFF7F7F8"/>
            <SolidColorBrush x:Key="Sd.BgRaised" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="Sd.Panel" Color="#FFF0F0F2"/>
            <SolidColorBrush x:Key="Sd.PanelHover" Color="#FFE7E7EB"/>
            <SolidColorBrush x:Key="Sd.PanelPressed" Color="#FFDDDEE3"/>
            <SolidColorBrush x:Key="Sd.Border" Color="#FFE0E0E5"/>
            <SolidColorBrush x:Key="Sd.BorderSoft" Color="#FFEBEBEF"/>
            <SolidColorBrush x:Key="Sd.Text" Color="#FF29292E"/>
            <SolidColorBrush x:Key="Sd.TextMuted" Color="#FF72727A"/>
            <SolidColorBrush x:Key="Sd.Accent" Color="#FF3478F6"/>
            <SolidColorBrush x:Key="Sd.AccentHover" Color="#FF2368E8"/>
            <SolidColorBrush x:Key="Sd.AccentPressed" Color="#FF1557C9"/>
            <SolidColorBrush x:Key="Sd.AccentSoft" Color="#FFE5EEFF"/>

            <!-- ===== Inspector field tokens =====
                 iOS inspector chrome (AnnotationInspectorStyle.swift) and TExP's
                 dialkit theme both derive every input surface from the ink color
                 at 3.5-9% and a hairline stroke, so fields read as one family. -->
            <SolidColorBrush x:Key="Sd.FieldFill" Color="#FFF2F2F4"/>
            <SolidColorBrush x:Key="Sd.FieldHover" Color="#FFE9E9EE"/>
            <SolidColorBrush x:Key="Sd.SelectionFill" Color="#FFE9E9EB"/>
            <SolidColorBrush x:Key="Sd.Groove" Color="#FFFAFAFC"/>
            <SolidColorBrush x:Key="Sd.SectionText" Color="#FF3A3A40"/>
            <SolidColorBrush x:Key="Sd.Danger" Color="#FFD13438"/>
            <SolidColorBrush x:Key="Sd.DangerSoft" Color="#FFFDECEC"/>

            <!-- Numeric readouts use a tabular mono face so digits never shift
                 width as values change (TExP pairs a JetBrains Mono readout
                 with tabular-nums). -->
            <FontFamily x:Key="Sd.MonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>

            <CornerRadius x:Key="Sd.Radius">8</CornerRadius>
            <CornerRadius x:Key="Sd.FieldRadius">8</CornerRadius>
            <Thickness x:Key="Sd.ButtonPadding">10,5,10,5</Thickness>

            <!-- ===== Field templates ===== -->

            <!-- Bare text surface: the surrounding pill supplies the chrome, so
                 the editor contributes only its own caret and selection. -->
            <ControlTemplate x:Key="Sd.FlatTextBox" TargetType="TextBox">
                <Grid>
                    <TextBlock x:Name="PlaceholderText"
                               Margin="{TemplateBinding Padding}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               Foreground="{StaticResource Sd.TextMuted}"
                               FontSize="{TemplateBinding FontSize}"
                               IsHitTestVisible="False"/>
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  Focusable="False"/>
                </Grid>
            </ControlTemplate>

            <!-- Standard field: hairline rounded box that grows a 2px accent
                 ring on focus, so keyboard focus is unmistakable. -->
            <ControlTemplate x:Key="Sd.FieldTextBox" TargetType="TextBox">
                <Border x:Name="Ring"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="9"
                        SnapsToDevicePixels="True">
                    <Border x:Name="Field"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="PlaceholderText"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Foreground="{StaticResource Sd.TextMuted}"
                                       FontSize="{TemplateBinding FontSize}"
                                       IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Focusable="False"/>
                        </Grid>
                    </Border>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Field" Property="Background" Value="{StaticResource Sd.FieldHover}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Sd.Accent}"/>
                        <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Sd.Accent}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Field" Property="Opacity" Value="0.45"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Base chrome shared by every button/toggle template -->
            <ControlTemplate x:Key="Sd.ChromeButton" TargetType="ButtonBase">
                <Border x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Sd.Radius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Default button: quiet panel chrome -->
            <Style x:Key="Sd.Button" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Sd.Panel}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="{StaticResource Sd.ButtonPadding}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template" Value="{StaticResource Sd.ChromeButton}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.PanelHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.PanelPressed}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Accent (primary action, e.g. Save) -->
            <Style x:Key="Sd.AccentButton" TargetType="Button" BasedOn="{StaticResource Sd.Button}">
                <Setter Property="Background" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.AccentHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.AccentPressed}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Ghost: low-emphasis actions (close/dismiss) -->
            <Style x:Key="Sd.GhostButton" TargetType="Button" BasedOn="{StaticResource Sd.Button}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.TextMuted}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.Panel}"/>
                        <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Tool toggle: segmented control look; checked = accent tint -->
            <Style x:Key="Sd.ToolToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.TextMuted}"/>
                <Setter Property="Padding" Value="8,6,8,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.Panel}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.AccentSoft}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark tooltip so popups match the chrome -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource Sd.Panel}"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,5,8,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Group separator used between toolbar clusters -->
            <Style x:Key="Sd.VSeparator" TargetType="Border">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Margin" Value="8,4,8,4"/>
                <Setter Property="Background" Value="{StaticResource Sd.BorderSoft}"/>
            </Style>

            <!-- ===== Form controls (settings window) ===== -->

            <!-- Implicit text field: rounded box + accent focus ring -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource Sd.FieldFill}"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="Padding" Value="9,5,9,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template" Value="{StaticResource Sd.FieldTextBox}"/>
            </Style>

            <!-- Value readout: tabular numerals, centered, sitting inside a
                 pill that owns the chrome. Mirrors the iOS inspector's
                 monospacedDigit value field and TExP's dialkit value input. -->
            <Style x:Key="Sd.ValueBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,0,4,0"/>
                <Setter Property="FontFamily" Value="{StaticResource Sd.MonoFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Template" Value="{StaticResource Sd.FlatTextBox}"/>
            </Style>

            <!-- Pill that wraps a value readout; the row turns its own ring on
                 when the inner editor takes focus. -->
            <Style x:Key="Sd.ValuePill" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Sd.FieldFill}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="58"/>
                <Setter Property="Padding" Value="4,0,4,0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- The label+track half of a slider row. Focus lands on the whole
                 scrubber pill, matching the iOS inspector's focused row. -->
            <Style x:Key="Sd.ScrubberPill" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Sd.FieldFill}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- Rounded combo with a custom chevron and a matching popup. -->
            <Style x:Key="Sd.ComboBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="9,6,9,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.AccentSoft}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Sd.ComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource Sd.FieldFill}"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="9,0,26,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource Sd.ComboBoxItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Ring"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        SnapsToDevicePixels="True">
                                    <Border x:Name="Field"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter x:Name="Site"
                                                              Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              IsHitTestVisible="False"
                                                              Content="{TemplateBinding SelectionBoxItem}"
                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                            <TextBlock x:Name="Arrow"
                                                       Grid.Column="1"
                                                       Margin="0,0,10,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="9"
                                                       Text="&#xE70D;"
                                                       Foreground="{StaticResource Sd.TextMuted}"/>
                                        </Grid>
                                    </Border>
                                </Border>
                                <ToggleButton x:Name="DropDownToggle"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       PopupAnimation="Fade">
                                    <Border Margin="0,4,0,0"
                                            Padding="4"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="260"
                                            Background="{StaticResource Sd.BgRaised}"
                                            BorderBrush="{StaticResource Sd.Border}"
                                            BorderThickness="1"
                                            CornerRadius="9">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Field" Property="Background" Value="{StaticResource Sd.FieldHover}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Sd.Accent}"/>
                                    <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Sd.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Sd.Accent}"/>
                                    <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource Sd.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Field" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One option inside a segmented track. The selected option reads
                 as a raised white tile, the way the iOS inspector and the
                 reference panel both present a segmented picker. -->
            <Style x:Key="Sd.Segment" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,5,8,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.PanelHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.BgRaised}"/>
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Track that holds a segmented control's options. -->
            <Style x:Key="Sd.SegmentedTrack" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Sd.FieldFill}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="3"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- Checkbox with a drawn check so it reads on dark surfaces -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box"
                                        Width="16" Height="16"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        Background="{StaticResource Sd.BgRaised}"
                                        BorderBrush="{StaticResource Sd.Border}"
                                        VerticalAlignment="Center">
                                    <Path x:Name="Check"
                                          Data="M2.5,7 L6,10.5 L11,3.5"
                                          Stroke="{StaticResource Sd.Text}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed"
                                          Stretch="None"/>
                                </Border>
                                <ContentPresenter Margin="7,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Sd.AccentSoft}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Sd.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Sd.TextMuted}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tab header pill -->
            <Style x:Key="Sd.TabItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource Sd.TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Chrome"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="14,6,14,6"
                                    Margin="0,0,4,0">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.Panel}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.PanelHover}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tab control shell: pill header row + rounded content card -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel IsItemsHost="True" Margin="0,0,0,10"/>
                                <Border Grid.Row="1"
                                        Background="{StaticResource Sd.BgRaised}"
                                        BorderBrush="{StaticResource Sd.BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <ContentPresenter ContentSource="SelectedContent"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The track renders its real decrease/increase portions, so
                 sliders stay usable with mouse, touch, and keys. -->
            <Style x:Key="Sd.SliderThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Ellipse Width="14" Height="14"
                                     Fill="{StaticResource Sd.BgRaised}"
                                     Stroke="{StaticResource Sd.Accent}"
                                     StrokeThickness="2.5"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Sd.Slider" TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6" CornerRadius="3" Background="{StaticResource Sd.Accent}"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6" CornerRadius="3" Background="{StaticResource Sd.Border}"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Sd.SliderThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pill slider used inside the inspector. The track is a thin
                 engraved groove rather than a heavy bar: 3px of accent on a
                 3px light rail, with a small white thumb, so the label stays
                 the loudest thing in the row (iOS sliderRadius/thin track,
                 TExP dialkit row). -->
            <Style x:Key="Sd.PillSliderThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid>
                                <Ellipse Width="11" Height="11" Fill="White" Stroke="#FFC8CAD0" StrokeThickness="1">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="2.5" ShadowDepth="0.5" Direction="270" Opacity="0.2" Color="#FF9AA0A8"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Sd.PillSlider" TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="3" CornerRadius="1.5" Background="{StaticResource Sd.Accent}"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="3" CornerRadius="1.5" Background="#FFE4E4E9"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Sd.PillSliderThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Screenstop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== Palette (mac Screenstop parity) =====
                 Workspace ground: AnnoTheme.neutralSolid dark (#292929 = white*0.16).
                 Accent/selection: tl color selection stroke, #3182ED.
                 Text: Apple label/secondaryLabel equivalents. -->
            <SolidColorBrush x:Key="Sd.Bg" Color="#FFF7F7F8"/>
            <SolidColorBrush x:Key="Sd.BgRaised" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="Sd.Panel" Color="#FFF0F0F2"/>
            <SolidColorBrush x:Key="Sd.PanelHover" Color="#FFE7E7EB"/>
            <SolidColorBrush x:Key="Sd.PanelPressed" Color="#FFDDDEE3"/>
            <SolidColorBrush x:Key="Sd.Border" Color="#FFE0E0E5"/>
            <SolidColorBrush x:Key="Sd.BorderSoft" Color="#FFEBEBEF"/>
            <SolidColorBrush x:Key="Sd.Text" Color="#FF29292E"/>
            <SolidColorBrush x:Key="Sd.TextMuted" Color="#FF72727A"/>
            <SolidColorBrush x:Key="Sd.Accent" Color="#FF3478F6"/>
            <SolidColorBrush x:Key="Sd.AccentHover" Color="#FF2368E8"/>
            <SolidColorBrush x:Key="Sd.AccentPressed" Color="#FF1557C9"/>
            <SolidColorBrush x:Key="Sd.AccentSoft" Color="#FFE5EEFF"/>

            <CornerRadius x:Key="Sd.Radius">8</CornerRadius>
            <Thickness x:Key="Sd.ButtonPadding">10,5,10,5</Thickness>

            <!-- Base chrome shared by every button/toggle template -->
            <ControlTemplate x:Key="Sd.ChromeButton" TargetType="ButtonBase">
                <Border x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Sd.Radius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Default button: quiet panel chrome -->
            <Style x:Key="Sd.Button" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Sd.Panel}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="{StaticResource Sd.ButtonPadding}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template" Value="{StaticResource Sd.ChromeButton}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.PanelHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.PanelPressed}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Accent (primary action, e.g. Save) -->
            <Style x:Key="Sd.AccentButton" TargetType="Button" BasedOn="{StaticResource Sd.Button}">
                <Setter Property="Background" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.AccentHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.AccentPressed}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Ghost: low-emphasis actions (close/dismiss) -->
            <Style x:Key="Sd.GhostButton" TargetType="Button" BasedOn="{StaticResource Sd.Button}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.TextMuted}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Sd.Panel}"/>
                        <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Tool toggle: segmented control look; checked = accent tint -->
            <Style x:Key="Sd.ToolToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.TextMuted}"/>
                <Setter Property="Padding" Value="8,6,8,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.Panel}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.AccentSoft}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark tooltip so popups match the chrome -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource Sd.Panel}"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,5,8,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Group separator used between toolbar clusters -->
            <Style x:Key="Sd.VSeparator" TargetType="Border">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Margin" Value="8,4,8,4"/>
                <Setter Property="Background" Value="{StaticResource Sd.BorderSoft}"/>
            </Style>

            <!-- ===== Form controls (settings window) ===== -->

            <!-- Implicit text field: dark input on every TextBox -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource Sd.BgRaised}"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{StaticResource Sd.Text}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="Padding" Value="6,3,6,3"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="Sd.ComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource Sd.Panel}"/>
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Sd.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="9,5,7,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinHeight" Value="30"/>
            </Style>

            <!-- Checkbox with a drawn check so it reads on dark surfaces -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box"
                                        Width="16" Height="16"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        Background="{StaticResource Sd.BgRaised}"
                                        BorderBrush="{StaticResource Sd.Border}"
                                        VerticalAlignment="Center">
                                    <Path x:Name="Check"
                                          Data="M2.5,7 L6,10.5 L11,3.5"
                                          Stroke="{StaticResource Sd.Text}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed"
                                          Stretch="None"/>
                                </Border>
                                <ContentPresenter Margin="7,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Sd.AccentSoft}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Sd.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Sd.TextMuted}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tab header pill -->
            <Style x:Key="Sd.TabItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource Sd.TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Chrome"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="14,6,14,6"
                                    Margin="0,0,4,0">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.Panel}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Sd.Text}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sd.PanelHover}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tab control shell: pill header row + rounded content card -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel IsItemsHost="True" Margin="0,0,0,10"/>
                                <Border Grid.Row="1"
                                        Background="{StaticResource Sd.BgRaised}"
                                        BorderBrush="{StaticResource Sd.BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <ContentPresenter ContentSource="SelectedContent"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The track renders its real decrease/increase portions, so
                 sliders stay usable with mouse, touch, and keys. -->
            <Style x:Key="Sd.SliderThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Ellipse Width="14" Height="14"
                                     Fill="{StaticResource Sd.BgRaised}"
                                     Stroke="{StaticResource Sd.Accent}"
                                     StrokeThickness="2.5"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Sd.Slider" TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource Sd.Accent}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6" CornerRadius="3" Background="{StaticResource Sd.Accent}"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6" CornerRadius="3" Background="{StaticResource Sd.Border}"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Sd.SliderThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
